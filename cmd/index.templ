package main

templ index(ansiHtml string, cfg Config) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>hello</title>
			<link href="css/style.css" rel="stylesheet"/>
			<link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css"/>
		</head>
		<style>
			:root {
				/* Set sans-serif & mono fonts */
				--sans-font: -apple-system, BlinkMacSystemFont, "Avenir Next", Avenir,
				"Nimbus Sans L", Roboto, "Noto Sans", "Segoe UI", Arial, Helvetica,
				"Helvetica Neue", sans-serif;
				--serif-font: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
				--mono-font: Consolas, Menlo, Monaco, "Andale Mono", "Ubuntu Mono", monospace;
				--standard-border-radius: 5px;
				--border-width: 1px;
				color-scheme: dark;
				--bg: #1a1b26; /* dark blue/black background */
				--accent-bg: #16161e; /* slightly lighter for panels */
				--text: #c0caf5; /* light text */
				--text-light: #565f89; /* secondary text */
				--border: #3b4261; /* subtle borders */
				--accent: #7aa2f7; /* blue accent */
				--accent-hover: #9ece6a; /* green accent hover */
				--accent-text: var(--bg);
				--code: #bb9af7; /* purple code */
				--preformatted: #2ac3de; /* cyan preformatted */
				--marked: #e0af68; /* warm highlight */
				--disabled: #414868; /* muted items */
			}

			/* Slight transparency for media */
			img,
			video {
				opacity: 0.9;
			}

			.post-link {
				font-size: 1.6rem;
				font-weight: bold;
			}

			.meta {
				color: var(--text-light);
			   font-size: 1rem;
			}

			.blog-item {
				margin-bottom: 4rem;
			}

			nav a.current {
				color: var(--accent) !important;
			   border-color: var(--accent) !important;
			}

			.medium {
				font-size: 1.4rem;
			}

			.small {
				font-size: 1rem;
			}

			.icon {
				vertical-align: sub;
				padding-right: .25rem;
				display: inline-block;
				width: 1em;
				height: 1.3em;
				margin-right: 0.2rem;
				stroke-width: 0;
				stroke: currentColor;
				fill: currentColor;
			}
		</style>
		<body>
			<header>
				<nav>
					<a href="/">Home</a>
					<a target="_blank" href="https://amitkrxyz.hashnode.dev">Blogs</a>
					<a target="_blank" href="https://github.com/amitkrxyz"><svg class="icon" viewBox="0 0 32 32"><path d="M16 0.395c-8.836 0-16 7.163-16 16 0 7.069 4.585 13.067 10.942 15.182 0.8 0.148 1.094-0.347 1.094-0.77 0-0.381-0.015-1.642-0.022-2.979-4.452 0.968-5.391-1.888-5.391-1.888-0.728-1.849-1.776-2.341-1.776-2.341-1.452-0.993 0.11-0.973 0.11-0.973 1.606 0.113 2.452 1.649 2.452 1.649 1.427 2.446 3.743 1.739 4.656 1.33 0.143-1.034 0.558-1.74 1.016-2.14-3.554-0.404-7.29-1.777-7.29-7.907 0-1.747 0.625-3.174 1.649-4.295-0.166-0.403-0.714-2.030 0.155-4.234 0 0 1.344-0.43 4.401 1.64 1.276-0.355 2.645-0.532 4.005-0.539 1.359 0.006 2.729 0.184 4.008 0.539 3.054-2.070 4.395-1.64 4.395-1.64 0.871 2.204 0.323 3.831 0.157 4.234 1.026 1.12 1.647 2.548 1.647 4.295 0 6.145-3.743 7.498-7.306 7.895 0.574 0.497 1.085 1.47 1.085 2.963 0 2.141-0.019 3.864-0.019 4.391 0 0.426 0.288 0.925 1.099 0.768 6.354-2.118 10.933-8.113 10.933-15.18 0-8.837-7.164-16-16-16z"></path></svg>GitHub</a>
				</nav>
				<h1>:>_ { cfg.Username }</h1>
				<p>{ cfg.About }</p>
			</header>
			<main>
				<div>
					|
					for _, link := range cfg.Links {
						|
						<a target="_blank" href={ link.Url }>
							{ link.Name }
						</a>
						|
					}
					|
				</div>
				<br/>
				<code style="margin-top:2rem;">$ curl amitkr.xyz</code>
				<pre style="">
					@templ.Raw(ansiHtml)
				</pre>
			</main>
			<footer>
				<p>
					© 2026 Amit Kumar 🇮🇳.
					Built with ♥️ in Go, Templ, HTML, CSS.
				</p>
			</footer>
		</body>
	</html>
}
